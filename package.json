{
  "name": "pustaka-terbuka-dbp",
  "version": "1.0.0",
  "description": "Pusat Dokumentasi Melayu (Dewan Bahasa dan Pustaka) (DBP) Bibliographic Dataset and Harvester for Pustaka Terbuka.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate-inbox": "node tools/validate-inbox.js",
    "harvest": "node tools/harvesters/dbp/harvester.js",
    "harvest:sample": "node tools/harvesters/dbp/harvester.js --max-records 10",
    "harvest:full": "node tools/harvesters/dbp/harvester.js --batch-size 1000 --delay 0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": false,
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.11.2"
  }
}